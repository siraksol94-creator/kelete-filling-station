{
  "name": "kelete-fuel-frontend",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "homepage": "./",
  "proxy": "http://localhost:5303",
  "dependencies": {
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/push-notifications": "^6.0.5",
    "@capacitor/share": "^6.0.4",
    "axios": "^1.6.2",
    "electron-updater": "^6.3.9",
    "html2pdf.js": "^0.14.0",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^7.2.2",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.1.3",
    "react-icons": "^4.12.0",
    "react-router-dom": "^6.20.1",
    "react-scripts": "5.0.1",
    "recharts": "^2.10.3",
    "kelete-print": "file:capacitor-plugins/kelete-print",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "@electron/rebuild": "^4.0.3",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron-builder": "^26.8.1",
    "wait-on": "^7.2.0"
  },
  "optionalDependencies": {
    "electron": "^34.5.8"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "build:web": "cross-env PUBLIC_URL=/ REACT_APP_API_URL=/api react-scripts build",
    "build:electron": "cross-env REACT_APP_API_URL=http://localhost:5303/api react-scripts build",
    "electron": "electron .",
    "electron:dev": "electron .",
    "dist": "npm run build:electron && electron-builder --win",
    "dist:publish": "npm run build:electron && electron-builder --win --publish always"
  },
  "build": {
    "extends": null,
    "appId": "com.sidanit.kelete",
    "productName": "Kelete",
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "frontend/build"
      },
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!node_modules/**",
          "!*.db",
          "!*.db-shm",
          "!*.db-wal",
          "!.env"
        ]
      },
      {
        "from": "../backend/node_modules",
        "to": "backend/node_modules"
      }
    ],
    "afterPack": "./scripts/afterPack.js",
    "publish": {
      "provider": "github",
      "owner": "siraksol94-creator",
      "repo": "kelete-filling-station"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version"
    ]
  }
}
